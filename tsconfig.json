{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "references": [
    {
      "path": "./apps/api"
    },
    {
      "path": "./apps/web"
    }
  ],
  "include": [],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
